// Finora Prisma Schema
// Mapped to Supabase PostgreSQL schema with RLS and high-density financial types

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(uuid()) @db.VarChar(36)
  authUserId     String          @unique @map("auth_user_id") @db.Uuid
  email          String          @unique @db.VarChar(255)
  hashedPassword String?         @map("hashed_password") @db.VarChar(255)
  fullName       String          @default("") @map("full_name") @db.VarChar(255)
  currency       String          @default("INR") @db.VarChar(10)
  preferences    Json            @default("{}")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  bankAccounts   BankAccount[]
  transactions   Transaction[]
  budgets        Budget[]
  financialGoals FinancialGoal[]
  mlProfile      MLProfile?

  @@map("users")
}

model Category {
  id               String           @id @default(uuid()) @db.VarChar(36)
  name             String           @unique @db.VarChar(100)
  slug             String           @unique @db.VarChar(100)
  icon             String           @default("Tag") @db.VarChar(50)
  colorHex         String           @default("#6366F1") @map("color_hex") @db.VarChar(20)
  isSystem         Boolean          @default(true) @map("is_system")
  parentId         String?          @map("parent_id") @db.VarChar(36)

  parent           Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]       @relation("CategoryHierarchy")
  merchants        Merchant[]
  transactions     Transaction[]
  budgetCategories BudgetCategory[]

  @@map("categories")
}

model Merchant {
  id                String        @id @default(uuid()) @db.VarChar(36)
  cleanName         String        @unique @map("clean_name") @db.VarChar(150)
  rawPatterns       Json          @default("[]") @map("raw_patterns")
  defaultCategoryId String?       @map("default_category_id") @db.VarChar(36)
  logoUrl           String?       @map("logo_url") @db.VarChar(255)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  defaultCategory   Category?     @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  transactions      Transaction[]

  @@map("merchants")
}

model BankAccount {
  id                  String        @id @default(uuid()) @db.VarChar(36)
  userId              String        @map("user_id") @db.VarChar(36)
  institutionName     String        @map("institution_name") @db.VarChar(100)
  accountNumberMasked String        @map("account_number_masked") @db.VarChar(50)
  accountType         String        @default("SAVINGS") @map("account_type") @db.VarChar(50)
  currentBalance      Decimal       @default(0) @map("current_balance") @db.Decimal(14, 2)
  currency            String        @default("INR") @db.VarChar(10)
  adapterType         String        @default("HSBC_DEMO") @map("adapter_type") @db.VarChar(50)
  lastSyncedAt        DateTime?     @map("last_synced_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        Transaction[]

  @@unique([id, userId], name: "uq_bank_accounts_id_user")
  @@index([userId], name: "accounts_user_idx")
  @@map("bank_accounts")
}

model Transaction {
  id             String       @id @default(uuid()) @db.VarChar(36)
  userId         String       @map("user_id") @db.VarChar(36)
  accountId      String       @map("account_id") @db.VarChar(36)
  categoryId     String?      @map("category_id") @db.VarChar(36)
  merchantId     String?      @map("merchant_id") @db.VarChar(36)
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(6)
  amount         Decimal      @db.Decimal(14, 2)
  currency       String       @default("INR") @db.VarChar(10)
  transactionType String      @default("DEBIT") @map("transaction_type") @db.VarChar(20)
  rawDescription String       @map("raw_description") @db.VarChar(500)
  balanceBefore  Decimal?     @map("balance_before") @db.Decimal(14, 2)
  balanceAfter   Decimal?     @map("balance_after") @db.Decimal(14, 2)
  referenceId    String       @map("reference_id") @db.VarChar(100)
  source         String       @default("BANK_API") @db.VarChar(50)
  dedupHash      String       @unique @map("dedup_hash") @db.VarChar(64)
  taxInfo        Json?        @map("tax_info")
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        BankAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  merchant       Merchant?    @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)], name: "transactions_user_occurred_at_idx")
  @@index([categoryId, occurredAt], name: "transactions_category_occurred_idx")
  @@index([dedupHash], name: "transactions_dedup_hash_idx")
  @@map("transactions")
}

model Budget {
  id               String           @id @default(uuid()) @db.VarChar(36)
  userId           String           @map("user_id") @db.VarChar(36)
  name             String           @db.VarChar(100)
  period           String           @default("MONTHLY") @db.VarChar(20)
  totalLimit       Decimal          @map("total_limit") @db.Decimal(14, 2)
  startDate        DateTime         @map("start_date") @db.Date
  endDate          DateTime         @map("end_date") @db.Date
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetCategories BudgetCategory[]

  @@index([userId], name: "budgets_user_idx")
  @@map("budgets")
}

model BudgetCategory {
  id                       String   @id @default(uuid()) @db.VarChar(36)
  budgetId                 String   @map("budget_id") @db.VarChar(36)
  categoryId               String   @map("category_id") @db.VarChar(36)
  allocatedAmount          Decimal  @map("allocated_amount") @db.Decimal(14, 2)
  alertThresholdPercentage Decimal  @default(85.00) @map("alert_threshold_percentage") @db.Decimal(5, 2)

  budget                   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category                 Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId], name: "uq_budget_category")
  @@map("budget_categories")
}

model FinancialGoal {
  id                       String          @id @default(uuid()) @db.VarChar(36)
  userId                   String          @map("user_id") @db.VarChar(36)
  title                    String          @db.VarChar(150)
  goalType                 String          @default("SAVINGS") @map("goal_type") @db.VarChar(50)
  targetAmount             Decimal         @map("target_amount") @db.Decimal(14, 2)
  currentSaved             Decimal         @default(0) @map("current_saved") @db.Decimal(14, 2)
  monthlyContribution      Decimal         @default(0) @map("monthly_contribution") @db.Decimal(14, 2)
  targetDate               DateTime        @map("target_date") @db.Date
  expectedAnnualReturnPct  Decimal         @default(7.00) @map("expected_annual_return_pct") @db.Decimal(5, 2)
  status                   String          @default("ACTIVE") @db.VarChar(20)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones               GoalMilestone[]

  @@index([userId, status], name: "goals_user_status_idx")
  @@map("financial_goals")
}

model GoalMilestone {
  id           String        @id @default(uuid()) @db.VarChar(36)
  goalId       String        @map("goal_id") @db.VarChar(36)
  title        String        @db.VarChar(150)
  targetAmount Decimal       @map("target_amount") @db.Decimal(14, 2)
  targetDate   DateTime      @map("target_date") @db.Date
  isAchieved   Boolean       @default(false) @map("is_achieved")
  achievedAt   DateTime?     @map("achieved_at") @db.Timestamptz(6)

  goal         FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("goal_milestones")
}

model MLProfile {
  id                            String   @id @default(uuid()) @db.VarChar(36)
  userId                        String   @unique @map("user_id") @db.VarChar(36)
  behaviouralScore              Decimal  @default(50.00) @map("behavioural_score") @db.Decimal(5, 2)
  impulseSpendingIndex          Decimal  @default(0.0000) @map("impulse_spending_index") @db.Decimal(5, 4)
  averageMonthlyBurn            Decimal  @default(0) @map("average_monthly_burn") @db.Decimal(14, 2)
  predictedSavingsRate          Decimal  @default(0.0000) @map("predicted_savings_rate") @db.Decimal(5, 4)
  categorySpendingDistribution  Json     @default("{}") @map("category_spending_distribution")
  weekendVsWeekdayRatio         Json     @default("{}") @map("weekend_vs_weekday_ratio")
  lastComputedAt                DateTime @default(now()) @map("last_computed_at") @db.Timestamptz(6)

  user                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ml_profiles")
}
