PROJECT_NAME=Finora
ENVIRONMENT=development
DEBUG=false
AUTH_PROVIDER=supabase

# Copy these from the Supabase dashboard. The publishable key is safe for API
# key identification; never use a secret/service_role key in the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Supabase Dashboard → Connect → Session pooler. Keep the password URL-encoded.
# Use the exact host and username Supabase gives you.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:URL_ENCODED_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres?ssl=require

SECRET_KEY=REPLACE_WITH_A_RANDOM_VALUE_FOR_LOCAL_JWT_ONLY
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
